{
  "STM32VSCodeExtension.cubeCLT.path": "C:/ST/STM32CubeCLT_1.21.0",
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "cmake.cmakePath": "C:/ST/STM32CubeCLT_1.21.0/CMake/bin/cmake.exe",
  "cmake.environment": {
    "PATH": "C:/ST/STM32CubeCLT_1.21.0/GNU-tools-for-STM32/bin;C:/ST/STM32CubeCLT_1.21.0/Ninja/bin;${env:PATH}"
  },
  "stm32cube-ide-build-cmake.intellisense.enableAutomaticConfiguration": false,
  "stm32cube-ide-clangd.enable": false,
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.default.configurationProvider": "",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
  "C_Cpp.default.compilerPath": "C:/ST/STM32CubeCLT_1.21.0/GNU-tools-for-STM32/bin/arm-none-eabi-gcc.exe",
  "C_Cpp.default.compilerArgs": [
    "-mcpu=cortex-m4",
    "-mfpu=fpv4-sp-d16",
    "-mfloat-abi=hard"
  ],
  "C_Cpp.default.intelliSenseMode": "windows-gcc-arm",
  "C_Cpp.default.cStandard": "gnu11",
  "C_Cpp.default.defines": ["DEBUG", "USE_HAL_DRIVER", "STM32G474xx"],
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/Application",
    "${workspaceFolder}/Core/Inc",
    "${workspaceFolder}/Drivers/STM32G4xx_HAL_Driver/Inc",
    "${workspaceFolder}/Drivers/STM32G4xx_HAL_Driver/Inc/Legacy",
    "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32G4xx/Include",
    "${workspaceFolder}/Drivers/CMSIS/Include"
  ],
  "C_Cpp.default.browse.path": [
    "${workspaceFolder}/Application",
    "${workspaceFolder}/Core",
    "${workspaceFolder}/Drivers"
  ],
  "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": true,
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "files.associations": {
    "*.h": "c"
  }
}
